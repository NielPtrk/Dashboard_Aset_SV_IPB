# ─── Vite React Frontend Dockerfile ──────────────────────────────────────────────
FROM node:20-slim AS builder
WORKDIR /app

# Ensure devDependencies (vite, typescript, etc) are installed even if NODE_ENV=production is set
ENV NODE_ENV=development

# Install dependencies
COPY package*.json ./
RUN npm ci --include=dev

# Copy source code and build Vite app
COPY . .

# Build arguments for frontend environment variables
ARG VITE_API_URL
ARG VITE_TURNSTILE_SITE_KEY
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY

RUN npm run build

# ─── Production Stage (Nginx Alpine) ─────────────────────────────────────────────
FROM nginx:alpine AS runner

# Copy built static files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration for SPA routing
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
